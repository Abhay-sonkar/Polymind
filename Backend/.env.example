MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_long_random_secret
OPENROUTER_API_KEY=your_openrouter_api_key_here
FRONTEND_URL=http://localhost:5173
PORT=8080

# Optional — URL of the Python RAG microservice (Backend/ai_services).
# Only needed if you're running document upload/retrieval. If unset or
# unreachable, chat still works normally, just without document context.
RAG_SERVICE_URL=http://localhost:8001
